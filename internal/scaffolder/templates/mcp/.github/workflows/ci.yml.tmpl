name: "{{.ProjectName}} CI/CD"

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

env:
  REGISTRY: cr.cloud.ru
  IMAGE_NAME: ${{ secrets.ARTIFACT_REGISTRY_ID }}/{{.ProjectName}}

jobs:
  lint:
    name: Lint & Format
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dev dependencies
        run: pip install black flake8 isort mypy

      - name: Check formatting (black)
        run: black --check src/

      - name: Check imports (isort)
        run: isort --check-only src/

      - name: Lint (flake8)
        run: flake8 src/ --max-line-length 120

  test:
    name: Tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run tests
        run: python -m pytest tests/ -v --tb=short

  build:
    name: Build & Push Image
    needs: [lint, test]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop'

    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - name: Login to Cloud.ru Artifact Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.IAM_KEY_ID }}
          password: ${{ secrets.IAM_SECRET }}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.sha }}
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest

  deploy:
    name: Deploy to Cloud.ru
    needs: build
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    environment: production

    steps:
      - uses: actions/checkout@v4

      - name: Install ai-agents-cli
        run: |
          wget -q https://github.com/cloud-ru/evo-ai-agents-cli/releases/latest/download/ai-agents-cli-linux -O ai-agents-cli
          chmod +x ai-agents-cli

      - name: Validate configuration
        run: ./ai-agents-cli validate mcp-servers.yaml
        env:
          IAM_KEY_ID: ${{ secrets.IAM_KEY_ID }}
          IAM_SECRET: ${{ secrets.IAM_SECRET }}
          PROJECT_ID: ${{ secrets.PROJECT_ID }}

      - name: Deploy MCP server
        run: ./ai-agents-cli mcp-servers deploy mcp-servers.yaml
        env:
          IAM_KEY_ID: ${{ secrets.IAM_KEY_ID }}
          IAM_SECRET: ${{ secrets.IAM_SECRET }}
          PROJECT_ID: ${{ secrets.PROJECT_ID }}
          ARTIFACT_REGISTRY_URL: ${{ env.REGISTRY }}
