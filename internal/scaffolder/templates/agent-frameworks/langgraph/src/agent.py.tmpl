"""
{{.ProjectName}} - LangChain/LangGraph Agent for Cloud.ru AI Agents

Uses LangChain AgentExecutor with OpenAI-compatible Cloud.ru Foundation Models.
"""

import logging
import os
from typing import Dict, List, Optional

from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from langchain.agents import AgentExecutor, create_openai_tools_agent
from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder
from langchain_openai import ChatOpenAI
from pydantic import BaseModel
from pydantic_settings import BaseSettings, SettingsConfigDict
import uvicorn

load_dotenv()

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class Settings(BaseSettings):
    agent_name: str = "{{.ProjectName}}"
    model_name: str = "{{.ModelName}}"
    fm_api_key: str = ""
    foundation_models_endpoint: str = "https://foundation-models.api.cloud.ru/v1"
    system_prompt: str = "Ты полезный AI-ассистент. Отвечай на русском языке."
    debug: bool = True
    host: str = "0.0.0.0"
    port: int = 8000

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")


settings = Settings()


def create_agent_executor() -> AgentExecutor:
    """Create a LangChain agent with Cloud.ru Foundation Models."""
    llm = ChatOpenAI(
        model=settings.model_name,
        base_url=settings.foundation_models_endpoint,
        api_key=settings.fm_api_key,
        temperature=0.7,
    )

    prompt = ChatPromptTemplate.from_messages([
        ("system", settings.system_prompt),
        MessagesPlaceholder(variable_name="chat_history"),
        ("human", "{input}"),
        MessagesPlaceholder(variable_name="agent_scratchpad"),
    ])

    tools = []  # Add MCP tools or custom tools here
    agent = create_openai_tools_agent(llm, tools, prompt)

    return AgentExecutor(
        agent=agent,
        tools=tools,
        verbose=True,
        handle_parsing_errors=True,
        max_iterations=15,
    )


agent_executor = create_agent_executor()

app = FastAPI(
    title=f"{settings.agent_name} LangGraph Agent",
    description="{{.Description}}",
    version="1.0.0",
)


class ProcessRequest(BaseModel):
    message: str


class ProcessResponse(BaseModel):
    response: str
    model: str


@app.post("/agent/process", response_model=ProcessResponse)
async def process_message(req: ProcessRequest):
    """Process a message through the LangChain agent."""
    try:
        result = agent_executor.invoke({"input": req.message, "chat_history": []})
        return ProcessResponse(response=result.get("output", ""), model=settings.model_name)
    except Exception as e:
        logger.error("LangChain agent error: %s", e)
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health():
    return {"status": "ok", "agent": settings.agent_name, "framework": "langgraph", "model": settings.model_name}


def main():
    uvicorn.run("src.agent:app", host=settings.host, port=settings.port, reload=settings.debug)


if __name__ == "__main__":
    main()
