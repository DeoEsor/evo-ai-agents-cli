# Cloud.ru AI Agents Configuration
IAM_KEY_ID=your_iam_key_id_here
IAM_SECRET_KEY=your_iam_secret_key_here
IAM_ENDPOINT=https://iam.api.cloud.ru
PROJECT_ID=your_project_id_here
CUSTOMER_ID=your_customer_id_here

# Cloud.ru Foundation Models
FOUNDATION_MODELS_ENDPOINT=https://foundation-models.api.cloud.ru/v1
MODEL_NAME={{.ModelName}}

# Agent Configuration
AGENT_NAME={{.ProjectName}}
AGENT_DESCRIPTION={{.Description}}

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://agent:agent@localhost:5432/{{.ProjectName}}_db

# Development
DEBUG=true
LOG_LEVEL=INFO
