"""
{{.ProjectName}} - AI Agent using ADK Framework + Cloud.ru Foundation Models
"""

import logging
from contextlib import asynccontextmanager
from typing import Dict, List, Optional

import httpx
import uvicorn
from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from pydantic_settings import BaseSettings

load_dotenv()

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class Settings(BaseSettings):
    agent_name: str = "{{.ProjectName}}"
    foundation_models_endpoint: str = "https://foundation-models.api.cloud.ru/v1"
    model_name: str = "{{.ModelName}}"
    fm_api_key: str = ""
    iam_key_id: str = ""
    iam_secret: str = ""
    iam_endpoint: str = "https://iam.api.cloud.ru"
    database_url: str = "postgresql://agent:agent@localhost:5432/{{.ProjectName}}_db"
    debug: bool = True
    host: str = "0.0.0.0"
    port: int = 8000

    class Config:
        env_file = ".env"


settings = Settings()


class FoundationModelsClient:
    """Cloud.ru Foundation Models API client (OpenAI-compatible)."""

    def __init__(self, endpoint: str, model: str):
        self.endpoint = endpoint.rstrip("/")
        self.model = model
        self.client = httpx.AsyncClient(timeout=60.0)
        self._token: Optional[str] = None

    async def _get_token(self) -> str:
        """Get API key or IAM token for Foundation Models authentication."""
        if self._token:
            return self._token
        if settings.fm_api_key:
            self._token = settings.fm_api_key
            return self._token
        if not settings.iam_key_id or not settings.iam_secret:
            raise ValueError("FM_API_KEY or IAM_KEY_ID+IAM_SECRET must be set")
        resp = await self.client.post(
            f"{settings.iam_endpoint}/api/v1/auth/token",
            json={"keyId": settings.iam_key_id, "secret": settings.iam_secret},
        )
        resp.raise_for_status()
        self._token = resp.json().get("access_token", "")
        return self._token

    async def chat(self, messages: List[Dict], temperature: float = 0.7) -> str:
        """Send chat completion request to Foundation Models API."""
        token = await self._get_token()
        resp = await self.client.post(
            f"{self.endpoint}/chat/completions",
            headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
            json={
                "model": self.model,
                "messages": messages,
                "temperature": temperature,
            },
        )
        resp.raise_for_status()
        data = resp.json()
        return data["choices"][0]["message"]["content"]

    async def list_models(self) -> List[Dict]:
        """List available models."""
        token = await self._get_token()
        resp = await self.client.get(
            f"{self.endpoint}/models",
            headers={"Authorization": f"Bearer {token}"},
        )
        resp.raise_for_status()
        return resp.json().get("data", [])

    async def close(self):
        await self.client.aclose()


fm_client: Optional[FoundationModelsClient] = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    global fm_client
    fm_client = FoundationModelsClient(
        endpoint=settings.foundation_models_endpoint,
        model=settings.model_name,
    )
    logger.info("Agent %s started with model %s", settings.agent_name, settings.model_name)
    yield
    if fm_client:
        await fm_client.close()
    logger.info("Agent %s stopped", settings.agent_name)


app = FastAPI(
    title=f"{settings.agent_name} Agent",
    description="{{.Description}}",
    version="1.0.0",
    lifespan=lifespan,
)


class ProcessRequest(BaseModel):
    message: str
    temperature: float = 0.7
    system_prompt: str = "Ты полезный AI ассистент. Отвечай на русском языке."


class ProcessResponse(BaseModel):
    response: str
    model: str


@app.post("/agent/process", response_model=ProcessResponse)
async def process_message(req: ProcessRequest):
    """Process a message through the AI agent."""
    if not fm_client:
        raise HTTPException(status_code=503, detail="Agent not initialized")
    try:
        messages = [
            {"role": "system", "content": req.system_prompt},
            {"role": "user", "content": req.message},
        ]
        response = await fm_client.chat(messages, temperature=req.temperature)
        return ProcessResponse(response=response, model=settings.model_name)
    except httpx.HTTPStatusError as e:
        logger.error("Foundation Models API error: %s", e)
        raise HTTPException(status_code=e.response.status_code, detail=str(e))
    except Exception as e:
        logger.error("Agent processing error: %s", e)
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/agent/models")
async def list_models():
    """List available Foundation Models."""
    if not fm_client:
        raise HTTPException(status_code=503, detail="Agent not initialized")
    try:
        models = await fm_client.list_models()
        return {"models": models}
    except Exception as e:
        logger.error("Error listing models: %s", e)
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health():
    return {"status": "ok", "agent": settings.agent_name, "model": settings.model_name}


def main():
    uvicorn.run(
        "src.agent:app",
        host=settings.host,
        port=settings.port,
        reload=settings.debug,
    )


if __name__ == "__main__":
    main()
