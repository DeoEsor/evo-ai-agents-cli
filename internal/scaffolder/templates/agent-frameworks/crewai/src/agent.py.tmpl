"""
{{.ProjectName}} - CrewAI Agent for Cloud.ru AI Agents

Multi-agent crew with coordinator and executor roles.
Uses LiteLLM for Cloud.ru Foundation Models integration.
"""

import logging
import os
from typing import Dict, List, Optional

from crewai import Agent, Crew, Process, Task
from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from pydantic_settings import BaseSettings, SettingsConfigDict
import uvicorn

load_dotenv()

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class Settings(BaseSettings):
    agent_name: str = "{{.ProjectName}}"
    model_name: str = "{{.ModelName}}"
    fm_api_key: str = ""
    foundation_models_endpoint: str = "https://foundation-models.api.cloud.ru/v1"
    debug: bool = True
    host: str = "0.0.0.0"
    port: int = 8000

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")


settings = Settings()

os.environ["OPENAI_API_KEY"] = settings.fm_api_key
os.environ["OPENAI_API_BASE"] = settings.foundation_models_endpoint


def create_crew(user_request: str) -> Crew:
    """Create a CrewAI crew with coordinator and executor agents."""
    coordinator = Agent(
        role="Координатор",
        goal="Проанализировать запрос и составить план выполнения",
        backstory="Опытный координатор, эффективно распределяющий задачи.",
        verbose=True,
        allow_delegation=True,
        llm=settings.model_name,
    )

    executor = Agent(
        role="Исполнитель",
        goal="Выполнить задачу и дать детальный ответ",
        backstory="Квалифицированный специалист с широкими знаниями.",
        verbose=True,
        allow_delegation=False,
        llm=settings.model_name,
    )

    analyze_task = Task(
        description=f"Проанализируй запрос пользователя: {user_request}",
        agent=coordinator,
        expected_output="План выполнения задачи",
    )

    execute_task = Task(
        description=f"Выполни запрос: {user_request}",
        agent=executor,
        expected_output="Детальный ответ на запрос пользователя",
    )

    return Crew(
        agents=[coordinator, executor],
        tasks=[analyze_task, execute_task],
        process=Process.sequential,
        verbose=True,
    )


app = FastAPI(
    title=f"{settings.agent_name} CrewAI Agent",
    description="{{.Description}}",
    version="1.0.0",
)


class ProcessRequest(BaseModel):
    message: str


class ProcessResponse(BaseModel):
    response: str
    model: str


@app.post("/agent/process", response_model=ProcessResponse)
async def process_message(req: ProcessRequest):
    """Process a message through the CrewAI crew."""
    try:
        crew = create_crew(req.message)
        result = crew.kickoff()
        return ProcessResponse(response=str(result), model=settings.model_name)
    except Exception as e:
        logger.error("CrewAI error: %s", e)
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health():
    return {"status": "ok", "agent": settings.agent_name, "framework": "crewai", "model": settings.model_name}


def main():
    uvicorn.run("src.agent:app", host=settings.host, port=settings.port, reload=settings.debug)


if __name__ == "__main__":
    main()
